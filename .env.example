# Copy to .env.local (or just run `npm run dev`, which generates one for you).

# Long random string used to sign authority session cookies (required)
AUTH_SECRET=change-me-to-a-long-random-string

# Password for the /admin command centre (required)
ADMIN_PASSWORD=change-me

# Optional: use your own PostgreSQL. If omitted, `npm run dev` starts an embedded local one on port 5433.
# DATABASE_URL=postgres://campus:campus@localhost:5432/campus
